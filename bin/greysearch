#!/usr/bin/env python3
"""thin bin wrapper matching the repo's launcher style (greysearch-portal.py etc.)"""
import sys
from pathlib import Path
ROOT = str(Path(__file__).resolve().parents[1])
sys.path.insert(0, ROOT)
if __name__ == '__main__':
    import greysearch_cli
    raise SystemExit(greysearch_cli.main())
